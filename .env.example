# Copy to .env.

# ── Required ────────────────────────────────────────────────────────────────
# Backend API origin (backend/). If it's unset or unreachable the site still renders,
# just without SEO overrides or the announcement banner.
VITE_API_URL=http://localhost:8787

# Origin the site is deployed at, written into registry.json as its homepage so
# shadcn installs resolve, e.g. https://oxyn.space
REGISTRY_HOMEPAGE=http://localhost:3000

# ── Analytics (optional) ────────────────────────────────────────────────────
# Umami script and website id. Loaded in production builds only; leave empty to disable.
VITE_UMAMI_SCRIPT_URL=https://umami.lok1.dev/script.js
VITE_UMAMI_WEBSITE_ID=15e5e9d1-a056-4a4b-983f-1d3dd05a1097
